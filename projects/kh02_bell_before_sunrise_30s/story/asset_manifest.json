    "clips": {
      "build/voice_clips/S01_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S01",
        "text": "Before dawn, Pip found the bell rope.",
        "start_sec": 0.16,
        "end_sec": 2.685,
        "measured_duration_sec": 2.5248,
        "rms": 0.1067,
        "sha256": "f39cdaa00e01ea4ece0ac95fd69838e77aebbb3174b226320ea7b7baa3be1b08"
      },
      "build/voice_clips/S02_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S02",
        "text": "Tavi had one rule: wait for sunrise.",
        "start_sec": 3.22,
        "end_sec": 6.062,
        "measured_duration_sec": 2.842,
        "rms": 0.10577,
        "sha256": "5e42c67708e094ba00632ed5c521b0e4c7c9a2a16b6af877711a9a8a3c3e59c8"
      },
      "build/voice_clips/S03_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S03",
        "text": "He lunged, but the rope slipped free.",
        "start_sec": 6.7,
        "end_sec": 9.144,
        "measured_duration_sec": 2.4438,
        "rms": 0.08569,
        "sha256": "98bb5610624656e9be31331e33330301c9c3727ab3c7cb1a2d55cdacfd687604"
      },
      "build/voice_clips/S04_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S04",
        "text": "One tug set the whole bell tower shaking.",
        "start_sec": 10.24,
        "end_sec": 12.661,
        "measured_duration_sec": 2.421,
        "rms": 0.11682,
        "sha256": "c30de5eae3ebe78a4b877602ea070e08f0101dc24dc89a19b6e046e3a0d4025c"
      },
      "build/voice_clips/S05_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S05",
        "text": "He sprinted up the stairs to catch the clapper.",
        "start_sec": 13.75,
        "end_sec": 16.213,
        "measured_duration_sec": 2.4632,
        "rms": 0.09677,
        "sha256": "a08432a13050e293a6952c7177f6d4c4c90f85ea0625c52d412f8728de2e1255"
      },
      "build/voice_clips/S06_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S06",
        "text": "For one breathless second, total silence.",
        "start_sec": 17.85,
        "end_sec": 20.715,
        "measured_duration_sec": 2.8649,
        "rms": 0.10754,
        "sha256": "f780a34d27f837c8fb978a4005128d9e21df63fc42d88a6ce8df506970c72d7f"
      },
      "build/voice_clips/S07_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S07",
        "text": "Then little Pip sneezed.",
        "start_sec": 23.14,
        "end_sec": 24.545,
        "measured_duration_sec": 1.4046,
        "rms": 0.09541,
        "sha256": "d5072e360cc732f3251db33b04e6240fea37018ae784f750233136f709c6e408"
      },
      "build/voice_clips/S08_tts.wav": {
        "origin": "LOCAL_OS_SAPI_TTS_1X_MEASURED",
        "shot_id": "S08",
        "text": "And Rome woke up an hour early.",
        "start_sec": 26.78,
        "end_sec": 28.568,
        "measured_duration_sec": 1.7876,
        "rms": 0.12951,
        "sha256": "f1b9ad593adecddf113e2c1ab0fd769a473ba0ebfc9d9045f6a0cbc87d913336"
